{
  "mcpServers": {
    "macbook-status": {
      "command": "/path/to/macbook-mcp-server/.venv/bin/python",
      "args": [
        "-m",
        "macbook_status_mcp.server"
      ],
      "env": {
        "PYTHONPATH": "/path/to/macbook-mcp-server/src",
        "MCP_TRANSPORT": "stdio",
        "MCP_SERVER_NAME": "MacBook Status"
      }
    }
  }
}
