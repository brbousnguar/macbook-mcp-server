# Optional. The server reads plain environment variables; defaults are shown.
# Load into your shell with: set -a; source .env; set +a

# Name shown to MCP clients
MCP_SERVER_NAME="MacBook Status"

# stdio (Claude Desktop, same machine) or streamable-http (remote clients)
MCP_TRANSPORT=stdio

# HTTP transport only
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Set to true to bind 0.0.0.0. Only do this behind a private network or proxy.
MCP_BIND_PUBLIC=false
# When set, HTTP clients must send "Authorization: Bearer <token>"
MCP_SHARED_TOKEN=
# Client-facing URL when it differs from MCP_HOST:MCP_PORT
MCP_EXTERNAL_BASE_URL=
